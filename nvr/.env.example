# cp .env.example .env 후 값 수정.  .env 는 절대 커밋하지 말 것 (.gitignore 에 포함됨)
TZ=Asia/Seoul

# ---- Hikvision NVR (카메라 1~4 = NVR 채널 1~4) ----
# 비밀번호에 @ : / # % 가 있으면 URL 인코딩 필요 (예: @ -> %40)
NVR_USER=admin
NVR_PASS=change-me
NVR_IP=192.168.0.100

# ---- Tapo 카메라 (cam5). Tapo 앱 > 카메라 설정 > 고급 설정 > 카메라 계정 ----
TAPO_USER=change-me
TAPO_PASS=change-me
TAPO_IP=192.168.0.101

# ---- go2rtc 접근 제어 ----
# RTSP 재송출(8554) 인증: Frigate / PC 뷰어가 이 계정으로 접속
RELAY_USER=relay
RELAY_PASS=change-me-too
# 웹 UI/API(1984) 인증. API 는 스트림 소스 추가가 가능하므로 반드시 설정
GO2RTC_API_USER=admin
GO2RTC_API_PASS=change-me-three
# WebRTC ICE 후보로 광고할 서버 LAN IP (브라우저/모바일이 접속할 주소)
HOST_IP=192.168.0.10

# Frigate 는 FRIGATE_ 접두사 환경변수만 config.yml 의 {FRIGATE_...} 로 치환한다
FRIGATE_RTSP_USER=relay
FRIGATE_RTSP_PASSWORD=change-me-too
